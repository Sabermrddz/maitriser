MONGODB_URI=mongodb://localhost:27017/quizapp
JWT_SECRET=change_this_to_a_long_random_string_in_production
CLERK_SECRET_KEY=sk_live_<your-clerk-secret-key>
ADMIN_SECRET_CODE=<your-admin-secret-code>
PORT=4000

# Comma-separated list of allowed frontend origins (no trailing slash)
# For production, set to your deployed frontend URLs:
#   CORS_ORIGIN=https://quizapp.example.com,https://admin.quizapp.example.com
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Set NODE_ENV=production to enable HSTS (2-year) and disable stack traces in errors
# NODE_ENV=production

# Optional: secret used to sign cookies (falls back to JWT_SECRET if not set)
# COOKIE_SECRET=

# Optional: set to "true" to disable JWT fallback when Clerk is configured
# DISABLE_JWT_FALLBACK=

# Optional: log level (debug, info, warn, error)
# LOG_LEVEL=info

# SMTP (optional — only needed for email verification / password reset)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
GMAIL_USER=
GMAIL_PASS=
EMAIL_FROM=noreply@quizapp.local

# Cloudflare R2 (file storage for PDFs & images)
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=<your-r2-access-key>
# R2_SECRET_ACCESS_KEY=<your-r2-secret-key>
# R2_BUCKET_NAME=quizapp-assets
# R2_PRESIGNED_EXPIRY=3600
